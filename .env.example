# Krishi Mama — Backend environment template
# Copy this file to .env and fill in values.
# NEVER put real credentials in this file and NEVER commit .env to Git.

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (MongoDB Atlas) ----
# Paste your full Atlas SRV connection string in .env only (never in .env.example).
# Format: mongodb+srv://<DB_USER>:<DB_PASSWORD>@<cluster>.../krishimama?retryWrites=true&w=majority
MONGODB_URI=

# ---- CORS ----
# Comma-separated list of allowed frontend origins (supports CORS_ORIGIN or CLIENT_URL)
CORS_ORIGIN=http://localhost:3000

# ---- Authentication (JWT) ----
# Strong 32+ character random secret for signing authentication session cookies
# Must be set to a high-entropy secret in production!
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Logging ----
LOG_LEVEL=info

# ---- Google Gemini AI Assistant (Phase 7.1) ----
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- NASA Earthdata (Optional — required only for live granule ingestion jobs) ----
# Normal server runtime uses pre-ingested MongoDB records and static snapshots.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ---- Google OAuth 2.0 (Optional — for Google Sign-In & Sign-Up) ----
# Obtain from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# See GOOGLE_OAUTH_SETUP_GUIDE.md for detailed setup instructions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

